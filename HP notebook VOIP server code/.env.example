# Copy this file to .env on the HP Notebook 2000.
# Bind on all network interfaces so other LAN devices can connect.
VOIP_BIND_HOST=0.0.0.0
VOIP_PORT=8766
# Set this to the HP Notebook 2000's LAN IPv4 address (find with `ipconfig`).
# Example format only; do not use this example unless it is actually your IP.
VOIP_ADVERTISE_HOST=SET_HP_NOTEBOOK_LAN_IPV4
# Signaling-only service. Keep this port LAN-only in Windows Firewall.
