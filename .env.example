# Local server configuration for the Steam console.
# Copy this file to .env and replace the placeholder with your own Steam Web API key.
# Keep .env private and never commit it to GitHub.
STEAM_WEB_API_KEY=PASTE_YOUR_STEAM_WEB_API_KEY_HERE

# Optional: use this if automatic detection picks the wrong Steam account.
# STEAM_ID64=7656119XXXXXXXXXX

# Optional: route Party Chat signaling through the HP Notebook 2000.
# Replace the placeholder with the HP's actual LAN IPv4 address from ipconfig.
# The voice signaling server listens on port 8766; keep it LAN-only.
VITE_VOIP_SERVER_URL=ws://SET_HP_NOTEBOOK_LAN_IPV4:8766
