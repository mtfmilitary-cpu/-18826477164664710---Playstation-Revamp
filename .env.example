# Local server configuration for the Steam console.
STEAM_WEB_API_KEY=PASTE_YOUR_STEAM_WEB_API_KEY_HERE

# Steam OpenID session signing. Generate a cryptographically random secret (32+ bytes).
# Never commit the real secret.
STEAM_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
STEAM_OPENID_ORIGIN=http://127.0.0.1:3000

# Optional update-check configuration; this is not a complete updater.
CONSOLE_UPDATE_VERSION=0.0.0
CONSOLE_UPDATE_MANIFEST_URL=

# Optional: use this if automatic detection picks the wrong Steam account.
# STEAM_ID64=7656119XXXXXXXXXX

# Optional Party Chat signaling server. Keep LAN-only unless separately secured.
VITE_VOIP_SERVER_URL=ws://SET_HP_NOTEBOOK_LAN_IPV4:8766
